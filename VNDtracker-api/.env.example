PORT=3000
NODE_ENV=development

# Local dev: use discrete DB_* vars. Production (Supabase/Neon/etc.): set
# DATABASE_URL instead (takes priority over the DB_* vars below) and DB_SSL=true.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vndtracker
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
# DATABASE_URL=

JWT_SECRET=
JWT_EXPIRES_IN=7d

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
