PORT=3000
NODE_ENV=development

# Local dev: use discrete DB_* vars. Production (Supabase/Neon/etc.): set
# DATABASE_URL instead (takes priority over the DB_* vars below) and DB_SSL=true.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vndtracker
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
# DATABASE_URL=

# Required -- the server refuses to start without it. Any long random string.
JWT_SECRET=
JWT_EXPIRES_IN=7d

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Local dev: leave unset (defaults to http://localhost:5173).
# Production: set to the deployed frontend URL (Vercel), e.g.
# https://vndtracker.vercel.app
CORS_ORIGIN=

# Local dev: leave unset (STORAGE_DRIVER defaults to local disk uploads/).
# Production: set STORAGE_DRIVER=supabase since PaaS free tiers (Render
# included) wipe the local filesystem on every deploy/restart.
STORAGE_DRIVER=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=receipts

# Local dev: leave RESEND_API_KEY unset -- password reset links are logged
# to the console instead of emailed. Production: set it to send real emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=VNDtracker <onboarding@resend.dev>

# Used to build the password reset link sent by email. Local dev defaults to
# http://localhost:5173. Production: set to the deployed frontend URL.
FRONTEND_URL=
